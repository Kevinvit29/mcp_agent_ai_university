# Copy to .env and replace EVERY placeholder before production.
# Do not commit .env, backups, dump files, or real API keys.
APP_ENV=development

# At least 32 unique random characters each. Example generator:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-unique-32-plus-character-secret
MCP_INTERNAL_KEY=replace-with-a-different-unique-32-plus-character-secret
ACCESS_TOKEN_TTL_SECONDS=28800
AUDIT_LOGGING_ENABLED=true
TRUST_PROXY_HEADERS=false

# Browser origin(s), comma-separated. Production must use explicit HTTPS origins.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
FRONTEND_PORT=3100
PUBLIC_APP_URL=http://localhost:3100

# Database service credentials. MONGO_URI must URL-encode special characters.
MONGO_ROOT_USERNAME=university_root
MONGO_ROOT_PASSWORD=replace-with-a-strong-mongo-password
MONGO_DB=university_mongo
MONGO_URI=mongodb://university_root:replace-with-a-strong-mongo-password@mongo:27017/?authSource=admin
POSTGRES_DB=university_db
POSTGRES_USER=university_user
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Stable Docker volume names. These preserve data across V29.2+ folder upgrades.
# For a one-time upgrade that must retain an older named volume, replace only the
# appropriate value after checking `docker volume ls`.
MONGO_VOLUME_NAME=university_ai_mongo_data
POSTGRES_VOLUME_NAME=university_ai_postgres_data
REPORTS_VOLUME_NAME=university_ai_reports
DOCUMENT_VIEWS_VOLUME_NAME=university_ai_document_views

# Initial administrator bootstrap (used only when PostgreSQL has no admin account).
# At first successful startup this is converted into a PBKDF2 hash in PostgreSQL.
# After that, changing or removing these values does NOT change Admin login.
ADMIN_BOOTSTRAP_USERNAME=ADMIN
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator

# Legacy migration compatibility only: an existing V29 .env with ADMIN_PASSWORD
# is accepted once when no database admin record exists. Remove it after migration.
# ADMIN_USERNAME=ADMIN
# ADMIN_PASSWORD=

# Demo-only fallback: use false in production. Production student/advisor accounts
# must have password_hash values or authenticate through a real identity provider.
ALLOW_LEGACY_DEMO_PASSWORDS=true

# V30 local demo defaults. These are ignored/refused in production.
# The backend verifies that BOTH MongoDB and PostgreSQL have 1,000 fictional
# students before the chat is considered ready. Set both to false for a real-data
# installation after importing your own records.
DEMO_DATA_MODE=true
AUTO_SEED_SYNTHETIC_DATA=true

# AI provider settings
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=120
GEMINI_INTENT_TIMEOUT=60
GEMINI_DOCUMENT_TIMEOUT=240
GEMINI_STATUS_TIMEOUT=15
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT=120
AI_NATURALIZE_DATABASE_ANSWERS=false

# Local retrieval / controlled learning
AUTO_INDEX_EXISTING_DATABASE_AGENTS=true
NEURAL_EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
GEMINI_EMBEDDING_TIMEOUT=20
AUTO_TRAINING_ENABLED=true
AUTO_TRAINING_INTERVAL_SECONDS=300
AUTO_TRAINING_PROVIDER=local
LOCAL_ROUTER_LEARNING_ENABLED=true
CONTROLLED_LEARNING_REVIEW_ENABLED=true

# V30 supervised local neural router. This trains only from curated and
# admin-published correction examples; it never fine-tunes Gemini/OpenAI.
NEURAL_ROUTER_AUTO_TRAINING=true
